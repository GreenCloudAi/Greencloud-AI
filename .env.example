# ───────────────────────────────────────────────────────────────
# GreenCloud AI — Environment Configuration
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local to git (it's in .gitignore).
# ───────────────────────────────────────────────────────────────

# AWS Credentials for the LOCAL DEVELOPMENT machine.
# These are used ONLY for the initial STS AssumeRole call.
# They are NEVER stored in the database or exposed to the frontend.
# In production, use IAM Instance Profile or OIDC federation instead.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1

# ─── GreenCloud Scan Configuration ──────────────────────────────
# Comma-separated list of AWS regions to scan for resources.
GREENCLOUD_SCAN_REGIONS=us-east-1

# CPU utilization % below which an EC2 instance is flagged as idle.
GREENCLOUD_IDLE_CPU_THRESHOLD=5.0

# Number of days of CloudWatch history to fetch per instance.
GREENCLOUD_CLOUDWATCH_LOOKBACK_DAYS=7

# CloudWatch aggregation period in seconds (86400 = daily).
GREENCLOUD_CLOUDWATCH_PERIOD_SECONDS=86400

# Peak CPU % below which a rightsizing recommendation is generated.
GREENCLOUD_RIGHTSIZING_PEAK_CPU=40.0

# STS session duration in seconds (900 = 15 min, max 3600 = 1 hr).
GREENCLOUD_STS_SESSION_DURATION=900

# Max retries for AWS API calls.
GREENCLOUD_MAX_RETRIES=3

# Base delay (ms) for exponential backoff between retries.
GREENCLOUD_RETRY_BASE_DELAY_MS=1000
